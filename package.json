{
  "name": "easytrader-mcp",
  "version": "1.2.0",
  "description": "Production-ready Model Context Protocol (MCP) Server for EasyTrader (Mofid Securities / d.easytrader.ir)",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "easytrader-mcp": "./bin/cli.js"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "login": "node ./bin/cli.js login",
    "bridge": "node ./bin/cli.js bridge",
    "bridge:install": "node scripts/install-bridge-daemon.js",
    "bridge:uninstall": "node scripts/uninstall-bridge-daemon.js",
    "test": "node src/test-connection.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "easytrader",
    "emofid",
    "mofid-securities",
    "tehran-stock-exchange",
    "tse",
    "tsetmc",
    "bourse",
    "iran-stock-market",
    "trading",
    "algorithmic-trading",
    "agentic-ai",
    "claude-desktop",
    "cursor",
    "antigravity",
    "بورس",
    "بورس-تهران",
    "کارگزاری-مفید",
    "ایزی-تریدر",
    "هوش-مصنوعی-بورس"
  ],
  "author": "Hesam",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "playwright": "^1.65.1",
    "zod": "^3.24.1"
  }
}
